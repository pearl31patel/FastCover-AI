{
    "manifest_version": 3,
    "name": "FastCover AI",
    "version": "1.0.0",
    "description": "Generate cover letters from job pages.",
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "FastCover AI"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
}